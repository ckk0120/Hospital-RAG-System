# ==================== A 模块环境变量配置 ====================
# 此文件用于 A 模块 (知识库构建)
# 
# 使用说明:
# 1. 复制此文件为 .env
# 2. 根据实际情况修改配置
# 3. B 模块需要使用相同的 EMBEDDING_MODEL 和 CHROMA_COLLECTION_NAME

# ChromaDB 持久化目录 (A 模块生成的数据库路径)
CHROMA_DB_DIR=./data/chroma_db

# Embedding 模型名称 (必须与 B 模块保持一致)
# 推荐使用中文友好的模型
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Chroma Collection 名称 (必须与 B 模块保持一致)
CHROMA_COLLECTION_NAME=langchain

# ==================== 其他可选配置 ====================

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 设备类型 (cpu, cuda, mps)
DEVICE=cpu
